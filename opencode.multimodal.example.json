{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Sample config for multimodal video/audio support. Copy to ~/.config/opencode/opencode.json and fill in your API key.",
  "provider": {
    "xiaomi-token-plan-cn": {
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1"
      },
      "models": {
        "mimo-v2-omni": {
          "name": "MiMo V2 Omni (Multimodal)",
          "modalities": {
            "input": ["text", "image", "video", "audio"],
            "output": ["text"]
          }
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5 (Multimodal)",
          "modalities": {
            "input": ["text", "image", "video", "audio"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
